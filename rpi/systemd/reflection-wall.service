# systemd-Dienst der Reflection Wall (ungeprüft bis zur Abnahme am Gerät)
# Einrichtung: siehe rpi/README.md, Abschnitt "Dienst einrichten"

[Unit]
Description=Reflection Wall, Anwendung auf dem Pi
# Nie aufgeben: auch nach vielen Abstürzen kurz hintereinander startet systemd den Dienst neu.
# Ohne Dienst schaltet der ESP den Pi nach drei PING hart aus.
StartLimitIntervalSec=0

[Service]
# anpassen: Benutzer, der in den Gruppen dialout, i2c und gpio ist
User=pi
# anpassen: Pfad zum Ordner rpi/ im Repository
WorkingDirectory=/home/pi/Reflection-Wall/rpi
# anpassen: Pfad zum Python des venv
ExecStart=/home/pi/.venvs/reflection-wall-rpi/bin/python -m app.main
# Stoppt systemd den Dienst beim Herunterfahren, bedient er noch 3 s weiter: Ein SHUTDOWN, das
# der ESP nach einem Reset noch einmal sendet (R8), bekommt so sein OK. Erst danach kommt SIGTERM.
ExecStop=/bin/sleep 3
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1
# Die Webseite läuft auf Port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
